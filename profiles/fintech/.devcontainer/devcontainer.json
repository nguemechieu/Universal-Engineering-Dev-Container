{
  "name": "Engineering: fintech",
  "build": {
    "dockerfile": "../../../images/Dockerfile",
    "context": "../../../images",
    "args": {
      "PROFILE": "base"
    }
  },
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },
    "ghcr.io/devcontainers/features/node:2": {
      "version": "22"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-docker",
        "ms-python.python",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
