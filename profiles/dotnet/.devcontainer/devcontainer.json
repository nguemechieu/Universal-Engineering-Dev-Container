{
  "name": "Engineering: dotnet",
  "build": {
    "dockerfile": "../../../images/Dockerfile",
    "context": "../../../images",
    "args": {
      "PROFILE": "base"
    }
  },
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "8.0"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
