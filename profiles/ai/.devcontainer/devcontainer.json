{
  "name": "Engineering: ai",
  "build": {
    "dockerfile": "../../../images/Dockerfile",
    "context": "../../../images",
    "args": {
      "PROFILE": "ai"
    }
  },
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-docker",
        "ms-python.python"
      ]
    }
  }
}
